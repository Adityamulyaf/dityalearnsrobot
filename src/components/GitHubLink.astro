---
interface Props {
	href: string;
	label?: string;
}

const { href, label = 'View on GitHub →' } = Astro.props;
---

<p class="github-link"><a href={href} target="_blank" rel="noopener noreferrer">{label}</a></p>

<style>
	.github-link {
		margin-top: 1.5rem;
		font-size: var(--sl-text-sm);
	}
</style>

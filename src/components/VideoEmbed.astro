---
interface Props {
	youtubeId: string;
	title: string;
}

const { youtubeId, title } = Astro.props;
---

<div class="video-embed">
	<iframe
		src={`https://www.youtube.com/embed/${youtubeId}`}
		title={title}
		loading="lazy"
		allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
		allowfullscreen
	></iframe>
</div>

<style>
	.video-embed {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		margin: 1.5rem 0;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 4px;
		overflow: hidden;
	}
	iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
